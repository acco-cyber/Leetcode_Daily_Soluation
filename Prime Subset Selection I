#include <bits/stdc++.h>
using namespace std;

class Solution {
public:
    vector<int> maxPrimes(int n, int s) {
        // Sieve of Eratosthenes to find all primes <= n
        vector<bool> isPrime(n + 1, true);
        if (n >= 0) isPrime[0] = false;
        if (n >= 1) isPrime[1] = false;
        for (int i = 2; i * i <= n; ++i) {
            if (isPrime[i]) {
                for (int j = i * i; j <= n; j += i) {
                    isPrime[j] = false;
                }
            }
        }

        vector<int> result;
        long long sum = 0;

        // Greedily take the smallest primes as long as the sum fits
        for (int i = 2; i <= n; ++i) {
            if (isPrime[i]) {
                if (sum + i <= s) {
                    result.push_back(i);
                    sum += i;
                } else {
                    // Primes are increasing, so no larger prime can fit either
                    break;
                }
            }
        }
        return result;
    }
};
