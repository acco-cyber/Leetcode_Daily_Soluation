var countPrimes = function(n) {
    if (n <= 2) return 0;

    let cnt = n - 2;
    const s = new Uint8Array(n);

    for (let i = 2; i * i < n; i++) {
        if (s[i] === 0) {
            for (let j = i * i; j < n; j += i) {
                if (s[j] === 0) {
                    s[j] = 1;
                    cnt--;
                }
            }
        }
    }
    return cnt;
};
